{
  "name": "@certa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "gen:openapi": "tsx scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@certa/core": "workspace:*",
    "@certa/db": "workspace:*",
    "@certa/rulepacks": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.1",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@certa/config": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5"
  }
}
