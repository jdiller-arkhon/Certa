# Certa environment. Copy to `.env` and fill in every value marked REQUIRED.
# Generate secrets with:  openssl rand -hex 32
# Use URL-safe values (hex is ideal) for passwords: they are embedded in connection URLs.

# ---------------------------------------------------------------- public URL
# Path prefix Certa is served under.
#   Hosted inside the Arkhon website:  BASE_PATH=/certa
#   Self-hosted at a domain root:      BASE_PATH=        (empty)
# Changing it requires rebuilding the web image (it is compiled into the app).
BASE_PATH=
# The URL people use to reach Certa, INCLUDING BASE_PATH. Must match exactly for sign-in to work.
#   e.g. https://arkhonindustries.com/certa   or   https://certa.example.com
PUBLIC_URL=http://localhost:8080
# Caddy site address. ":8080" serves plain HTTP on 8080. For automatic HTTPS on a real domain,
# set this to the hostname (e.g. certa.example.com), set HTTP_PORT=443 and expose ports 80/443.
CERTA_SITE_ADDRESS=:8080
HTTP_PORT=8080

# ---------------------------------------------------------------- database
POSTGRES_DB=certa
# Owner/superuser: runs migrations only. REQUIRED.
POSTGRES_USER=certa_owner
POSTGRES_PASSWORD=
# Application login role: no superuser, no BYPASSRLS. Created by the migrator. REQUIRED.
APP_DB_USER=certa_api
APP_DB_PASSWORD=

# Local development outside Docker (pnpm dev / tests). The API connects as the app role;
# the migrator and tests use the admin URL.
DATABASE_URL=postgres://certa_api:certa_api@localhost:5432/certa
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/certa

# ---------------------------------------------------------------- auth
# Signs sessions and magic links. At least 32 characters. REQUIRED.
AUTH_SECRET=
# Extra origins allowed to call auth endpoints (comma-separated), e.g. the Expo dev server.
TRUSTED_ORIGINS=

# ---------------------------------------------------------------- email
# SMTP relay URL. The bundled Mailpit catches all mail at http://localhost:8025 (dev only).
# Production: smtp://user:pass@smtp.internal.example.com:587
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Certa <no-reply@certa.local>
MAILPIT_PORT=8025

# ---------------------------------------------------------------- object storage (S3 API)
# Bundled SeaweedFS by default; point at AWS S3 or any S3-compatible store instead.
S3_ENDPOINT=http://objects:9000
S3_BUCKET=certa
S3_ACCESS_KEY_ID=certa
# REQUIRED.
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- notifications and lookups
# Web Push for expiry alerts. Generate once: npx web-push generate-vapid-keys
# Leave empty to turn push off (email alerts still work). Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or your site URL. Defaults to PUBLIC_URL.
VAPID_SUBJECT=
# Pre-flight conditions query free, keyless US government services (US only): api.weather.gov,
# the FAA on services6.arcgis.com and tfr.faa.gov, aviationweather.gov, and services.swpc.noaa.gov.
# "off" keeps the stack fully offline; airspace, TFRs and weather then show as "not checked".
CONDITIONS_LOOKUPS=on

# ---------------------------------------------------------------- operations
LOG_LEVEL=info
# API rate limit for auth endpoints, per client IP per minute.
RATE_LIMIT_AUTH_PER_MINUTE=20
# Header with the real client IP when Certa runs behind another proxy (the Arkhon website on
# Cloudflare: cf-connecting-ip). Leave empty unless the origin only accepts traffic from that proxy.
CLIENT_IP_HEADER=
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted. Bundled Caddy = 1.
# Add one per extra proxy hop that appends X-Forwarded-For (otherwise rate limits key on the proxy).
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------- web dev only
# Where `pnpm dev` proxies /api/* when not behind Caddy.
API_ORIGIN=http://localhost:4000

# Community Discord bot (Arkhon-ops-bot, bots/certa). Bearer token for its endpoints under
# /api/v1/discord, /api/v1/users and /api/v1/leaderboard; leave empty to disable them.
# Generate with: openssl rand -base64 48 — and set the same value as CERTA_API_TOKEN in the bot.
DISCORD_BOT_API_TOKEN=
