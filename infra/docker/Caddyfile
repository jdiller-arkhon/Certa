# Single origin: the web app and the API share a hostname (and base path) so session cookies
# need no CORS. BASE_PATH is '' for a root install or e.g. '/certa' when Certa is served inside
# the Arkhon website (see docs/ARKHON_SITE_INTEGRATION.md).
{
	admin off
}

{$CERTA_SITE_ADDRESS::8080} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
	handle {$BASE_PATH}/api/* {
		reverse_proxy api:4000
	}
	handle {$BASE_PATH}/healthz {
		reverse_proxy api:4000
	}
	handle {$BASE_PATH}/readyz {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
